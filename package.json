{
  "name": "portfolio",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "nuxt dev",
    "dev:api": "tsx watch server/src/index.ts",
    "build": "nuxt build",
    "build:api": "prisma generate && prisma migrate deploy",
    "prisma": "prisma",
    "preview": "nuxt preview",
    "start": "node .output/server/index.mjs",
    "start:api": "tsx server/src/index.ts",
    "typecheck": "nuxt typecheck && tsc -p server/tsconfig.json --noEmit",
    "lint": "eslint .",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:seed": "tsx server/src/seed.ts",
    "postinstall": "prisma generate && nuxt prepare"
  },
  "prisma": {
    "seed": "tsx server/src/seed.ts"
  },
  "dependencies": {
    "@fontsource-variable/martian-mono": "^5.3.0",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "gsap": "^3.15.0",
    "multer": "^2.3.0",
    "nuxt": "^4.5.2",
    "pg": "^8.23.0",
    "prisma": "7.10.0",
    "tsx": "^4.23.13",
    "vue": "^3.5.42",
    "vue-router": "^5.3.0"
  },
  "devDependencies": {
    "@nuxt/eslint": "^1.17.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.2.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.0",
    "eslint": "^10.10.0",
    "typescript": "^5.9.0",
    "vue-tsc": "^3.3.11"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/engines",
      "esbuild",
      "prisma",
      "unrs-resolver"
    ]
  }
}
