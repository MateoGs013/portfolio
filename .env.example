# Copiar a .env. Los valores coinciden con docker-compose.yml.
DATABASE_URL="postgresql://portfolio:portfolio@localhost:5432/portfolio?schema=public"
API_PORT=3001
NUXT_PUBLIC_API_BASE="http://localhost:3001/api"

# Origen público del sitio: canonical, hreflang, og:url, JSON-LD, sitemap y robots.txt salen de acá.
# Se lee al compilar y al correr el front; en producción tiene que ser el dominio real (ver DEPLOY.md).
NUXT_PUBLIC_SITE_URL="http://localhost:3000"

# Admin propio en /admin (servido por el API). Sin este valor el admin queda apagado.
ADMIN_TOKEN="cambiar-por-un-token-largo"

# Política CORS (orígenes permitidos separados por coma, sin wildcard *)
CORS_ORIGIN="http://localhost:3000,https://mateogs.tech"

# Eros (Job Hunter). Dirección interna del agente, sin valor por defecto: sin ella el admin muestra
# Eros como «no configurado» y el CV se arma igual desde la base. En Coolify es http://eros:8000 (DEPLOY.md).
HUNTER_API_URL="http://127.0.0.1:8000"
EROS_API_KEY="cambiar-por-clave-secreta-compartida-con-eros"
# EROS_DEMO=1: sin Eros, la cola muestra vacantes ficticias. Solo para pruebas y capturas, nunca en producción.
# EROS_DEMO=1
# HUNTER_LOCAL_FALLBACK=1: fuera de producción, si HUNTER_API_URL no responde, prueba con un Eros en 127.0.0.1:8000.
# HUNTER_LOCAL_FALLBACK=1
# El artículo de los lunes (9:00 de Buenos Aires): la API se lo pide a Eros y lo publica sola. Sin valor, encendido
# solo con NODE_ENV=production y HUNTER_API_URL; off lo apaga y on lo enciende en cualquier entorno (cuidado en local:
# HUNTER_API_URL apunta al Eros real y publicaría en tu base). scripts/admin-run.mjs lo apaga siempre.
# ARTICLES_WEEKLY=off
# «Enviar desde Eros»: on lo enciende (apagado sin valor). La API imprime el PDF del CV con Chromium: CHROMIUM_PATH
# (en la imagen, /usr/bin/chromium); fuera de producción, sin valor, usa el de Playwright. Cuidado en local: HUNTER_API_URL
# apunta al Eros real y mandaría correos de verdad. scripts/admin-run.mjs lo apaga salvo con --send (y Eros simulado).
# EROS_SEND_ENABLED=off
# CHROMIUM_PATH=

