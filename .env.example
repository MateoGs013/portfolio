# Copiar a .env. Los valores coinciden con docker-compose.yml.
DATABASE_URL="postgresql://portfolio:portfolio@localhost:5432/portfolio?schema=public"
API_PORT=3001
NUXT_PUBLIC_API_BASE="http://localhost:3001/api"

# Admin propio en /admin (servido por el API). Sin este valor el admin queda apagado.
ADMIN_TOKEN="cambiar-por-un-token-largo"
