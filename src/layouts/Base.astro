---
import { ClientRouter } from 'astro:transitions';
import '@fontsource-variable/archivo';
import '@fontsource-variable/archivo/wdth.css';
import '@fontsource/ibm-plex-mono/400.css';
import '@fontsource/ibm-plex-mono/500.css';
import '@fontsource/ibm-plex-mono/700.css';
import '../styles/tokens.css';
import '../styles/base.css';
import '../styles/ediciones.css';

interface Props {
  title?: string;
  description?: string;
  edicion?: 'afiche' | 'terminal' | 'plano' | 'fanzine' | 'ideacion' | 'maquetado' | 'programacion' | 'producto';
}

const {
  title = 'Mateo Sonzogni — Creative Developer',
  description = 'Portfolio de Mateo Sonzogni: interfaces con oficio, motion y WebGL. Un mismo portfolio, muchas tintas.',
  edicion = 'afiche',
} = Astro.props;
---

<!doctype html>
<html lang="es" data-tema={edicion}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <ClientRouter />
    <script is:inline data-astro-rerun>
      // Anti-FOUC: el modo claro/oscuro guardado se aplica antes del primer
      // paint. La edicion NO se restaura de localStorage: la fija la ruta
      // (data-tema server-side en <html>). data-astro-rerun: el swap de view
      // transitions pisa los atributos de <html> con los estaticos — este
      // script restaura data-theme en cada navegacion.
      (function () {
        try {
          var theme = localStorage.getItem('ms-theme');
          if (theme === 'light' || theme === 'dark') {
            document.documentElement.setAttribute('data-theme', theme);
          }
        } catch (e) {}
        // js-motion: los estados pre-animación (líneas cubiertas, etc.)
        // viven bajo esta clase — solo con JS vivo y sin reduced-motion.
        // Sin JS o con reduced-motion la página pinta completa (DESIGN.md §5.7).
        if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
          document.documentElement.classList.add('js-motion');
        }
      })();
    </script>
  </head>
  <body>
    <div id="toast" role="status"></div>
    <slot />
  </body>
</html>

<style>
  #toast {
    position: fixed;
    left: 50%;
    bottom: 26px;
    transform: translate(-50%, calc(100% + 40px));
    z-index: 95;
    background: var(--accent);
    color: var(--accent-ink);
    font-family: var(--font-m);
    font-size: 11px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    padding: 12px 18px;
    max-width: 92vw;
    transition: transform 0.45s cubic-bezier(0.2, 0.9, 0.3, 1.2);
  }
  #toast:global(.show) {
    transform: translate(-50%, 0);
  }
  @media (prefers-reduced-motion: reduce) {
    #toast {
      transition: none;
    }
  }
</style>
