---
import Base from '../layouts/Base.astro';
import Intro from '../components/Intro.astro';
import Topbar from '../components/Topbar.astro';
import Hero from '../components/Hero.astro';
---

<Base>
  <Intro />

  <div class="wipe" id="wipe" aria-hidden="true">
    <span id="wipe-label">reimprimiendo</span>
  </div>

  <Topbar />

  <main>
    <div class="wrap">
      <Hero />
    </div>

    <div class="marquee-strip" aria-hidden="true">
      <div class="marquee-track">
        <span class="marquee-seg only-afiche only-inline">
          Se exhibe trabajo real · <span class="hit">funciones todos los días en producción</span> · impreso en Buenos Aires ·&nbsp;
        </span>
        <span class="marquee-seg only-afiche only-inline">
          Se exhibe trabajo real · <span class="hit">funciones todos los días en producción</span> · impreso en Buenos Aires ·&nbsp;
        </span>
        <span class="marquee-seg only-terminal only-inline">
          $ status: <span class="hit">en producción</span> · laruculagastrobar.es · argpiscinas.es · 4 proyectos seleccionados ·&nbsp;
        </span>
        <span class="marquee-seg only-terminal only-inline">
          $ status: <span class="hit">en producción</span> · laruculagastrobar.es · argpiscinas.es · 4 proyectos seleccionados ·&nbsp;
        </span>
        <span class="marquee-seg only-plano only-inline">
          Láminas 01–04 · esc 1:1 · <span class="hit">dibujó: M. Sonzogni</span> · Río de la Plata · producción real ·&nbsp;
        </span>
        <span class="marquee-seg only-plano only-inline">
          Láminas 01–04 · esc 1:1 · <span class="hit">dibujó: M. Sonzogni</span> · Río de la Plata · producción real ·&nbsp;
        </span>
      </div>
    </div>

    <section class="teaser wrap" aria-label="Próximas secciones">
      <p class="teaser-note">En prensa — trabajos seleccionados, sobre mí y contacto llegan en el próximo paso.</p>
    </section>
  </main>

  <footer class="foot">
    <span>© 2026 Mateo Sonzogni</span>
    <span>Buenos Aires · Río de la Plata</span>
  </footer>
</Base>

<style>
  .wipe {
    position: fixed;
    inset: 0;
    z-index: 90;
    background: var(--ink);
    transform: translateY(-101%);
    pointer-events: none;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .wipe span {
    color: var(--bg);
    font-family: var(--font-m);
    font-size: 12px;
    letter-spacing: 0.3em;
    text-transform: uppercase;
  }

  .marquee-strip {
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
    overflow: hidden;
    white-space: nowrap;
    background: var(--bg2);
    transition: background-color 0.5s;
  }
  .marquee-track {
    display: inline-block;
    padding: 12px 0;
    font-family: var(--font-m);
    font-size: 12px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    animation: marquee 28s linear infinite;
  }
  .marquee-seg .hit {
    color: var(--accent);
  }
  @keyframes marquee {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(-50%);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .marquee-track {
      animation: none;
    }
  }

  .teaser {
    min-height: 46vh;
    display: flex;
    align-items: center;
  }
  .teaser-note {
    font-family: var(--font-m);
    font-size: 12px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--soft);
    max-width: 44em;
  }

  .foot {
    border-top: 1px solid var(--line);
    padding: 22px clamp(16px, 4vw, 48px);
    display: flex;
    justify-content: space-between;
    gap: 12px;
    flex-wrap: wrap;
    font-family: var(--font-m);
    font-size: 11px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--soft);
  }
</style>

<script>
  import '../scripts/site';
</script>
