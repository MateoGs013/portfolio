---
import Base from '../layouts/Base.astro';
import Topbar from '../components/Topbar.astro';
import Hero from '../components/Hero.astro';
---

<Base>
  <div class="wipe" id="wipe" aria-hidden="true">
    <span id="wipe-label">reimprimiendo</span>
  </div>

  <Topbar />

  <main>
    <div class="wrap">
      <Hero />
    </div>

    <section id="tirada" class="tirada" aria-label="La tirada">
      <div class="wrap" data-reveal>
        <div class="tirada-head">
          <h2>La tirada</h2>
          <p class="tirada-nota">4 piezas · 2 en producción</p>
        </div>
        <p class="tirada-placeholder">
          El pliego con los trabajos está en prensa — entra en la próxima edición de este sitio.
        </p>
      </div>
    </section>
  </main>

  <footer id="colofon" class="colofon" aria-label="Colofón">
    <div class="wrap" data-reveal>
      <h2>Colofón</h2>
      <p class="colofon-texto">
        Este sitio se compuso en Anton, IBM Plex Mono y Archivo, y se imprimió con Astro,
        GSAP y Lenis sobre papel digital. Edición al cuidado de su autor.
        Buenos Aires · Río de la Plata · 2026.
      </p>
      <p class="colofon-contacto">
        <a href="mailto:mateogabus@gmail.com">mateogabus@gmail.com</a>
        <span aria-hidden="true">·</span>
        <a href="https://github.com/MateoGs013" target="_blank" rel="noopener">github.com/MateoGs013</a>
      </p>
    </div>
  </footer>
</Base>

<style>
  .wipe {
    position: fixed;
    inset: 0;
    z-index: 90;
    background: var(--ink);
    transform: translateY(-101%);
    pointer-events: none;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .wipe span {
    color: var(--bg);
    font-family: var(--font-m);
    font-size: 12px;
    letter-spacing: 0.3em;
    text-transform: uppercase;
  }

  .tirada {
    border-top: 1px solid var(--line);
    padding: clamp(40px, 8vh, 90px) 0;
  }
  .tirada-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 16px;
    flex-wrap: wrap;
    margin-bottom: 18px;
  }
  .tirada-head h2 {
    margin: 0;
    font-family: var(--font-d);
    font-weight: var(--weight-d);
    font-size: clamp(1.5rem, 1rem + 2.2vw, 2.6rem);
  }
  .tirada-nota {
    margin: 0;
    font-family: var(--font-m);
    font-size: 12px;
    color: var(--soft);
    font-variant-numeric: tabular-nums;
  }
  .tirada-placeholder {
    margin: 0;
    color: var(--soft);
    max-width: 52ch;
  }

  .colofon {
    border-top: 1px solid var(--line);
    padding: clamp(30px, 6vh, 60px) 0 clamp(26px, 5vh, 50px);
  }
  .colofon h2 {
    margin: 0 0 12px;
    font-family: var(--font-d);
    font-weight: var(--weight-d);
    font-size: 1.15rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }
  .colofon-texto {
    margin: 0 0 14px;
    color: var(--soft);
    font-size: 0.92rem;
    max-width: 58ch;
  }
  .colofon-contacto {
    margin: 0;
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
    font-family: var(--font-m);
    font-size: 13px;
    overflow-wrap: anywhere;
  }
  .colofon-contacto a {
    color: var(--ink);
    text-decoration: none;
    border-bottom: 2px solid var(--accent);
    padding-bottom: 2px;
  }
  .colofon-contacto a:hover {
    color: var(--accent);
    text-shadow:
      -1.5px 0 var(--reg-c1),
      1.5px 0 var(--reg-c2);
  }
  .colofon-contacto span {
    color: var(--soft);
  }
</style>

<script>
  import '../scripts/site';
</script>
