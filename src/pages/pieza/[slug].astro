---
// Página de caso: /pieza/[slug]. El título viene morfeando desde la tirada
// (transition:name) y la imagen se "imprime" sola al cargar (halftone-auto).
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import Topbar from '../../components/Topbar.astro';
import { proyectos } from '../../data/proyectos';
import imgLaRucula from '../../assets/proyectos/la-rucula.jpg';
import imgArgpiscinas from '../../assets/proyectos/argpiscinas.jpg';
import imgBarberpole from '../../assets/proyectos/barberpole.png';

export function getStaticPaths() {
  return proyectos
    .filter((p) => p.caso)
    .map((p) => ({ params: { slug: p.slug }, props: { proyecto: p } }));
}

const imagenes: Record<string, ImageMetadata> = {
  'la-rucula': imgLaRucula,
  argpiscinas: imgArgpiscinas,
  barberpole: imgBarberpole,
};

const { proyecto: p } = Astro.props;
const caso = p.caso!;
const indice = proyectos.findIndex((x) => x.slug === p.slug);
const conCaso = proyectos.filter((x) => x.caso);
const siguiente = conCaso[(conCaso.findIndex((x) => x.slug === p.slug) + 1) % conCaso.length];
---

<Base
  title={`${p.titulo} — Mateo Sonzogni`}
  description={`Caso de estudio: ${p.titulo}. ${caso.intro}`}
>
  <Topbar />

  <main class="wrap caso">
    <header class="caso-cabecera">
      <p class="folio">
        Pieza {String(indice + 1).padStart(2, '0')} / {String(proyectos.length).padStart(2, '0')} · {p.estadoLabel} · {p.anio}
      </p>
      <h1 class="caso-titulo" transition:name={`pieza-${p.slug}`}>
        <span class="registro" data-text={p.titulo}>{p.titulo}</span>
      </h1>
      <p class="caso-intro">{caso.intro}</p>
    </header>

    {
      imagenes[p.slug] && (
        <div class="caso-hero" data-halftone data-halftone-auto>
          <Image
            src={imagenes[p.slug]}
            alt={`Captura de ${p.titulo} en producción`}
            widths={[640, 1000, 1400]}
            sizes="(max-width: 860px) 92vw, 76vw"
            loading="eager"
          />
          <canvas aria-hidden="true"></canvas>
        </div>
      )
    }

    <div class="caso-grid">
      <aside class="caso-ficha" aria-label="Ficha técnica">
        <dl>
          <div><dt>Rol</dt><dd>{p.rol}</dd></div>
          <div><dt>Tinta</dt><dd>{p.stack.join(' · ')}</dd></div>
          <div><dt>Año</dt><dd>{p.anio}</dd></div>
          <div><dt>Estado</dt><dd class={p.estado === 'produccion' ? 'vivo' : ''}>{p.estadoLabel}</dd></div>
        </dl>
        <a class="caso-link" href={p.url} target="_blank" rel="noopener">{p.urlLabel} ↗</a>
        <a class="caso-volver" href="/#tirada">← volver a la tirada</a>
      </aside>

      <div class="caso-cuerpo">
        {
          caso.secciones.map((s) => (
            <section class="caso-seccion" data-reveal>
              <h2>{s.titulo}</h2>
              <p>{s.texto}</p>
            </section>
          ))
        }

        <section class="caso-seccion" data-reveal>
          <h2>Resultado de tirada</h2>
          <ul class="caso-resultados">
            {caso.resultados.map((r) => <li>{r}</li>)}
          </ul>
        </section>

        <nav class="caso-siguiente" aria-label="Siguiente caso">
          <span>Siguiente pieza</span>
          <a href={`/pieza/${siguiente.slug}/`}>{siguiente.titulo} →</a>
        </nav>
      </div>
    </div>
  </main>

  <footer class="caso-pie">
    <div class="wrap">
      <a href="mailto:mateogabus@gmail.com">mateogabus@gmail.com</a>
      <span>Imprenta M·S · {p.anio}</span>
    </div>
  </footer>
</Base>

<style>
  .caso {
    padding-top: clamp(30px, 6vh, 70px);
  }
  .folio {
    margin: 0 0 12px;
    font-family: var(--font-m);
    font-size: 11px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--soft);
    font-variant-numeric: tabular-nums;
  }
  .caso-titulo {
    margin: 0 0 16px;
    font-family: var(--font-d);
    font-weight: var(--weight-d);
    font-size: clamp(2rem, 0.8rem + 6.4vw, 5.6rem);
    line-height: 0.98;
  }
  .registro {
    position: relative;
    display: inline-block;
    --r1x: 0em;
    --r1y: 0em;
    --r2x: 0em;
    --r2y: 0em;
    --rega: 0;
  }
  .registro::before,
  .registro::after {
    content: attr(data-text);
    position: absolute;
    inset: 0;
    z-index: -1;
    opacity: var(--rega);
    pointer-events: none;
  }
  .registro::before {
    color: var(--reg-c1);
    transform: translate(var(--r1x), var(--r1y));
  }
  .registro::after {
    color: var(--reg-c2);
    transform: translate(var(--r2x), var(--r2y));
  }
  .caso-intro {
    margin: 0 0 clamp(24px, 4vh, 40px);
    color: var(--soft);
    max-width: 52ch;
    font-size: clamp(0.98rem, 0.9rem + 0.3vw, 1.12rem);
  }

  .caso-hero {
    position: relative;
    border: 1px solid var(--line);
    overflow: hidden;
    aspect-ratio: 16 / 8.5;
    background: var(--bg2);
    margin-bottom: clamp(28px, 5vh, 56px);
  }
  .caso-hero img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top;
    opacity: 0;
  }
  .caso-hero canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }

  .caso-grid {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    gap: clamp(18px, 3vw, 44px);
    padding-bottom: clamp(40px, 8vh, 90px);
  }
  .caso-ficha {
    grid-column: 1 / 4;
    align-self: start;
    position: sticky;
    top: 76px;
    display: flex;
    flex-direction: column;
    gap: 18px;
  }
  .caso-ficha dl {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 8px;
    border-top: 1px solid var(--line);
    padding-top: 14px;
  }
  .caso-ficha dl div {
    display: grid;
    grid-template-columns: 64px 1fr;
    gap: 10px;
    align-items: baseline;
  }
  .caso-ficha dt {
    font-family: var(--font-m);
    font-size: 10px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--soft);
  }
  .caso-ficha dd {
    margin: 0;
    font-size: 0.92rem;
  }
  .caso-ficha dd.vivo {
    color: var(--accent);
    font-weight: 600;
  }
  .caso-link,
  .caso-volver {
    font-family: var(--font-m);
    font-size: 13px;
    text-decoration: none;
    color: var(--ink);
    align-self: flex-start;
    border-bottom: 3px solid var(--accent);
    padding-bottom: 3px;
  }
  .caso-volver {
    border-bottom-width: 1px;
    border-bottom-color: var(--line);
    color: var(--soft);
  }
  .caso-link:hover,
  .caso-volver:hover {
    color: var(--accent);
    text-shadow:
      -1.5px 0 var(--reg-c1),
      1.5px 0 var(--reg-c2);
  }

  .caso-cuerpo {
    grid-column: 5 / 12;
    display: flex;
    flex-direction: column;
    gap: clamp(28px, 5vh, 52px);
  }
  .caso-seccion h2 {
    margin: 0 0 10px;
    font-family: var(--font-d);
    font-weight: var(--weight-d);
    font-size: clamp(1.25rem, 1rem + 1.2vw, 1.9rem);
  }
  .caso-seccion p {
    margin: 0;
    max-width: 62ch;
    line-height: 1.65;
  }
  .caso-resultados {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 9px;
    max-width: 62ch;
  }
  .caso-resultados li {
    font-family: var(--font-m);
    font-size: 0.88rem;
    padding-left: 22px;
    position: relative;
  }
  .caso-resultados li::before {
    content: '✓';
    position: absolute;
    left: 0;
    color: var(--accent);
  }

  .caso-siguiente {
    border-top: 1px solid var(--line);
    padding-top: 20px;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .caso-siguiente span {
    font-family: var(--font-m);
    font-size: 10px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--soft);
  }
  .caso-siguiente a {
    font-family: var(--font-d);
    font-weight: var(--weight-d);
    font-size: clamp(1.3rem, 1rem + 1.6vw, 2.2rem);
    text-decoration: none;
    color: var(--ink);
  }
  .caso-siguiente a:hover {
    color: var(--accent);
    text-shadow:
      -2px 0 var(--reg-c1),
      2px 0 var(--reg-c2);
  }

  .caso-pie {
    border-top: 1px solid var(--line);
    padding: 20px 0;
  }
  .caso-pie .wrap {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    flex-wrap: wrap;
    font-family: var(--font-m);
    font-size: 12px;
    color: var(--soft);
  }
  .caso-pie a {
    color: var(--ink);
    text-decoration: none;
    border-bottom: 2px solid var(--accent);
    padding-bottom: 2px;
  }

  @media (max-width: 860px) {
    .caso-grid {
      grid-template-columns: 1fr;
    }
    .caso-ficha,
    .caso-cuerpo {
      grid-column: 1 / -1;
    }
    .caso-ficha {
      position: static;
    }
  }
</style>

<script>
  import '../../scripts/site';
</script>
