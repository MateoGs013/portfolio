---
// Página espécimen del sistema de diseño (referencia interna).
// Nació como home temporal del paso 2; quedó como herramienta de revisión.
import Base from '../layouts/Base.astro';
---

<Base title="Espécimen — sistema de diseño">
  <header class="topbar">
    <span class="brand">M·S — ESPÉCIMEN</span>
    <nav class="selector" aria-label="Edición">
      <button class="chip" data-esp-tema="afiche">Afiche</button>
      <button class="chip" data-esp-tema="terminal">Terminal</button>
      <button class="chip" data-esp-tema="plano">Plano</button>
      <button class="chip mode" id="esp-mode">Claro / Oscuro</button>
    </nav>
  </header>

  <main class="wrap">
    <section class="bloque">
      <p class="label">display · var(--font-d)</p>
      <p class="display">Mateo <span class="acc">Sonzogni</span></p>
    </section>

    <section class="bloque">
      <p class="label">mono · var(--font-m)</p>
      <p class="mono">$ whoami → creative developer · Buenos Aires · Río de la Plata · 0123456789</p>
    </section>

    <section class="bloque">
      <p class="label">body · var(--font-b)</p>
      <p class="body-sample">
        Hago interfaces donde el diseño y el código son la misma decisión. Cada proyecto se
        dibuja como una lámina: medido, acotado y llevado a <strong>producción real</strong>. Un
        <a href="#">link se ve así</a> y un <em>énfasis así</em>.
      </p>
    </section>

    <section class="bloque">
      <p class="label">paleta</p>
      <div class="chips-color">
        <div class="sw" style="background: var(--bg)"><span>bg</span></div>
        <div class="sw" style="background: var(--bg2)"><span>bg2</span></div>
        <div class="sw sw-ink" style="background: var(--ink)"><span>ink</span></div>
        <div class="sw sw-ink" style="background: var(--soft)"><span>soft</span></div>
        <div class="sw sw-acc" style="background: var(--accent)"><span>accent</span></div>
      </div>
    </section>

    <section class="bloque">
      <p class="label">superficie bg2 + línea</p>
      <div class="card">
        <p class="mono">Tirada: 0015 ejemplares</p>
        <p class="body-sample">Las superficies secundarias usan bg2 con borde línea.</p>
      </div>
    </section>
  </main>
</Base>

<style>
  .topbar {
    position: sticky;
    top: 0;
    display: flex;
    align-items: center;
    gap: 14px;
    flex-wrap: wrap;
    padding: 12px clamp(16px, 4vw, 48px);
    background: var(--bg);
    border-bottom: 1px solid var(--line);
  }
  .brand {
    font-family: var(--font-m);
    font-weight: 700;
    font-size: 13px;
    letter-spacing: 0.08em;
  }
  .selector {
    display: flex;
    gap: 6px;
    margin-left: auto;
    flex-wrap: wrap;
  }
  .chip {
    font-family: var(--font-m);
    font-size: 11px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    padding: 7px 12px;
    cursor: pointer;
    background: transparent;
    color: var(--ink);
    border: 1px solid var(--line);
    transition: all 0.25s;
  }
  .chip:hover {
    border-color: var(--accent);
    color: var(--accent);
  }
  .chip:global(.on) {
    background: var(--ink);
    color: var(--bg);
    border-color: var(--ink);
  }
  .chip.mode {
    background: var(--accent);
    color: var(--accent-ink);
    border-color: var(--accent);
  }

  .bloque {
    padding: clamp(28px, 5vh, 48px) 0;
    border-bottom: 1px solid var(--line);
  }
  .label {
    font-family: var(--font-m);
    font-size: 10px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--soft);
    margin: 0 0 14px;
  }
  .display {
    margin: 0;
    font-family: var(--font-d);
    font-weight: var(--weight-d);
    font-size: clamp(2.6rem, 1rem + 8vw, 7.5rem);
    line-height: 0.95;
    text-transform: uppercase;
    letter-spacing: 0.01em;
  }
  .display .acc {
    color: var(--accent);
  }
  .mono {
    margin: 0;
    font-family: var(--font-m);
    font-size: 14px;
    overflow-wrap: anywhere;
    font-variant-numeric: tabular-nums;
  }
  .body-sample {
    margin: 0;
    max-width: 38em;
    font-size: 1.05rem;
  }
  .body-sample a {
    color: var(--accent);
  }
  .chips-color {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
  }
  .sw {
    width: 110px;
    height: 72px;
    border: 1px solid var(--line);
    display: flex;
    align-items: flex-end;
    padding: 6px 8px;
  }
  .sw span {
    font-family: var(--font-m);
    font-size: 10px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink);
  }
  .sw-ink span {
    color: var(--bg);
  }
  .sw-acc span {
    color: var(--accent-ink);
  }
  .card {
    background: var(--bg2);
    border: 1px solid var(--line);
    padding: 18px 20px;
    display: flex;
    flex-direction: column;
    gap: 8px;
    max-width: 480px;
  }
</style>

<script is:inline>
  (function () {
    var root = document.documentElement;
    var chips = Array.prototype.slice.call(document.querySelectorAll('[data-esp-tema]'));

    function sync() {
      var actual = root.getAttribute('data-tema') || 'afiche';
      chips.forEach(function (c) {
        c.classList.toggle('on', c.getAttribute('data-esp-tema') === actual);
      });
    }

    chips.forEach(function (chip) {
      chip.addEventListener('click', function () {
        var tema = chip.getAttribute('data-esp-tema');
        root.setAttribute('data-tema', tema);
        try { localStorage.setItem('ms-tema', tema); } catch (e) {}
        sync();
      });
    });

    document.getElementById('esp-mode').addEventListener('click', function () {
      var attr = root.getAttribute('data-theme');
      var dark = attr ? attr === 'dark' : window.matchMedia('(prefers-color-scheme: dark)').matches;
      var next = dark ? 'light' : 'dark';
      root.setAttribute('data-theme', next);
      try { localStorage.setItem('ms-theme', next); } catch (e) {}
    });

    sync();
  })();
</script>
