---
// Barra superior: marca + selector de EDICIONES (rutas) + toggle claro/oscuro.
// El selector NAVEGA: cada edición es una ruta propia (/, /terminal, /plano,
// /fanzine) y el ClientRouter hace la transición. La edición activa se marca
// con aria-current según la URL. El toggle claro/oscuro (mode-btn) y el
// revelado del enlace Fanzine (data-tema-btn="fanzine", oculto) los maneja
// scripts/tema.ts; el desbloqueo por el clicker lo dispara scripts/imprenta.ts.
const p = Astro.url.pathname;
const activa =
  p.startsWith('/terminal') ? 'terminal'
  : p.startsWith('/plano') ? 'plano'
  : p.startsWith('/fanzine') ? 'fanzine'
  : p === '/' ? 'afiche'
  : '';
// En rutas de edición los links de sección son relativos (misma página); en
// pieza/especimen (activa vacía) vuelven a la home.
const secc = activa ? '' : '/';
---

<header class="topbar" id="topbar">
  <span class="brand">Imprenta M·S</span>
  <nav class="secciones" aria-label="Secciones">
    <a href={`${secc}#tirada`}>La tirada</a>
    <a href={`${secc}#colofon`}>Colofón</a>
  </nav>
  <nav class="selector" aria-label="Edición del portfolio">
    <span class="selector-label">Edición</span>
    <a class="chip" href="/" aria-current={activa === 'afiche' ? 'page' : undefined}>Afiche</a>
    <a class="chip" href="/terminal" aria-current={activa === 'terminal' ? 'page' : undefined}>Terminal</a>
    <a class="chip" href="/plano" aria-current={activa === 'plano' ? 'page' : undefined}>Plano</a>
    <a
      class="chip secreta"
      href="/fanzine"
      data-tema-btn="fanzine"
      aria-current={activa === 'fanzine' ? 'page' : undefined}
      hidden>Fanzine</a
    >
    <button class="chip mode" id="mode-btn" aria-label="Cambiar la tinta entre modo claro y oscuro">
      Tinta ◐
    </button>
  </nav>
</header>

<style>
  .topbar {
    position: sticky;
    top: 0;
    z-index: 40;
    display: flex;
    align-items: center;
    gap: 14px;
    flex-wrap: wrap;
    padding: 12px clamp(16px, 4vw, 48px);
    background: var(--bg);
    border-bottom: 1px solid var(--line);
    transition: background-color 0.5s;
  }
  .brand {
    font-family: var(--font-m);
    font-weight: 700;
    font-size: 13px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .secciones {
    display: flex;
    gap: 16px;
  }
  .secciones a {
    font-size: 13px;
    text-decoration: none;
    color: var(--soft);
    border-bottom: 1px solid transparent;
    transition: color 0.15s;
  }
  .secciones a:hover {
    color: var(--accent);
    text-shadow:
      -1.5px 0 var(--reg-c1),
      1.5px 0 var(--reg-c2);
  }
  .selector {
    display: flex;
    gap: 6px;
    margin-left: auto;
    flex-wrap: wrap;
    align-items: center;
  }
  .selector-label {
    font-family: var(--font-m);
    font-size: 10px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--soft);
    margin-right: 4px;
  }
  .chip {
    display: inline-flex;
    align-items: center;
    font-family: var(--font-m);
    font-size: 11px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    text-decoration: none;
    padding: 7px 12px;
    cursor: pointer;
    background: transparent;
    color: var(--ink);
    border: 1px solid var(--line);
    transition: all 0.25s;
  }
  .chip:hover {
    border-color: var(--accent);
    color: var(--accent);
  }
  /* Edición activa = la ruta actual (aria-current), antes era la clase .on. */
  .chip[aria-current='page'] {
    background: var(--ink);
    color: var(--bg);
    border-color: var(--ink);
  }
  .chip.secreta {
    border-color: var(--accent);
    color: var(--accent);
  }
  .chip.secreta:global(.pop) {
    animation: chip-pop 0.5s;
  }
  @keyframes chip-pop {
    0% {
      transform: scale(0.7);
    }
    60% {
      transform: scale(1.15);
    }
    100% {
      transform: scale(1);
    }
  }
  .chip.mode {
    background: transparent;
    color: var(--accent);
    border-color: var(--accent);
  }
  .chip.mode:hover {
    background: var(--accent);
    color: var(--accent-ink);
  }

  /* Mobile: menos chrome antes del contenido y targets táctiles WCAG
     (mín. 24px, apuntamos a 42-44px). */
  @media (max-width: 640px) {
    .topbar {
      padding: 8px 16px;
      gap: 8px;
    }
    .selector-label {
      display: none;
    }
    .secciones a,
    .chip {
      min-height: 42px;
    }
    .secciones {
      gap: 12px;
    }
  }
</style>
