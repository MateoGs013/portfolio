---
// La imprenta: el mini-juego del taller. Imprimís ejemplares; a los 20,
// el taller desbloquea la edición secreta Fanzine (scripts/imprenta.ts).
// Las 3 ediciones principales SIEMPRE están libres — esto es recompensa,
// nunca un gate (decisión de producto tras la auditoría UX).
---

<section id="imprenta" class="imprenta" aria-label="La imprenta — mini juego">
  <div class="wrap" data-reveal>
    <div class="imprenta-head">
      <h2>La imprenta</h2>
      <p class="imprenta-nota only-inline">taller abierto</p>
    </div>
    <p class="imprenta-texto">
      Esta página sale de acá. Podés imprimir tus propios ejemplares — el taller lleva la
      cuenta, y dicen que <strong>a los 20 pasa algo</strong>.
    </p>
    <div class="prensa">
      <button id="prensa-btn">Imprimir ejemplar</button>
      <div class="prensa-info">
        <span id="tirada-num">Tirada: 0000 ejemplares</span>
        <span id="prensa-estado" aria-live="polite"></span>
      </div>
    </div>
  </div>
</section>

<style>
  .imprenta {
    border-top: 1px solid var(--line);
    padding: clamp(36px, 7vh, 76px) 0;
  }
  .imprenta-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 16px;
    flex-wrap: wrap;
    margin-bottom: 14px;
  }
  .imprenta-head h2 {
    margin: 0;
    font-family: var(--font-d);
    font-weight: var(--weight-d);
    font-size: clamp(1.5rem, 1rem + 2.2vw, 2.6rem);
  }
  .imprenta-nota {
    margin: 0;
    font-family: var(--font-m);
    font-size: 12px;
    color: var(--soft);
  }
  .imprenta-texto {
    margin: 0 0 22px;
    color: var(--soft);
    max-width: 52ch;
  }
  .imprenta-texto strong {
    color: var(--ink);
  }

  .prensa {
    display: flex;
    align-items: center;
    gap: 20px;
    flex-wrap: wrap;
    border: 1px solid var(--line);
    background: var(--bg2);
    padding: 16px 18px;
    max-width: 560px;
    transition: background-color 0.5s;
  }
  #prensa-btn {
    font-family: var(--font-m);
    text-transform: uppercase;
    letter-spacing: 0.14em;
    font-size: 12px;
    padding: 14px 22px;
    min-height: 44px;
    cursor: pointer;
    background: var(--ink);
    color: var(--bg);
    border: 1px solid var(--ink);
    transition: transform 0.08s, background-color 0.25s, color 0.25s;
  }
  #prensa-btn:active {
    transform: translateY(3px) scale(0.97);
  }
  #prensa-btn:hover {
    background: var(--accent);
    border-color: var(--accent);
    color: var(--accent-ink);
  }
  .prensa-info {
    display: flex;
    flex-direction: column;
    gap: 5px;
    font-family: var(--font-m);
    font-size: 12px;
    min-width: 0;
  }
  #tirada-num {
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.08em;
  }
  #prensa-estado {
    color: var(--soft);
    font-size: 11px;
    letter-spacing: 0.06em;
    overflow-wrap: anywhere;
  }
  #prensa-estado:global(.hito) {
    color: var(--accent);
  }
</style>
