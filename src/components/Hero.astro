---
// Portada del pliego. El masthead es la "plancha" (efecto registro de
// tintas en scripts/registro.ts); el resto se imprime por barridos.
// Reglas por edición (folio, reglas del masthead, métricas) en ediciones.css.
---

<section class="portada" aria-label="Portada">
  <header class="masthead">
    <p class="folio only-afiche">Año I · Pliego Nº 001 · Buenos Aires · sale cuando hay algo que mostrar</p>
    <p class="folio only-terminal">MATEO_SONZOGNI(1) — manual del pliego · sección 001 · Buenos Aires</p>
    <p class="folio only-plano">Lámina 001 · portada · esc 1:1 · dibujó: M.S. · Buenos Aires</p>
    <p class="folio only-fanzine">fanzine m·s · edición pirata · nº 001 · fotocopiado en buenos aires</p>
    <h1 class="hero-title">
      <span class="registro" data-text="Mateo Sonzogni">Mateo Sonzogni</span>
    </h1>
    <div class="masthead-rule" aria-hidden="true"></div>
  </header>

  <div class="portada-grid">
    <h2 class="titular only-afiche" data-reveal>
      Dos clientes en producción en España, un SaaS propio y una tesis que respira WebGL.
    </h2>
    <h2 class="titular only-terminal" data-reveal>
      $ uptime → 2 clientes en producción · 1 SaaS propio · 1 tesis WebGL. Nada guardado en un
      cajón.
    </h2>
    <h2 class="titular only-plano" data-reveal>
      Memoria descriptiva: dos obras entregadas y en uso en España, un producto propio y una
      tesis en cálculo.
    </h2>
    <h2 class="titular only-fanzine" data-reveal>
      Dos clientes vivos, un SaaS y una tesis. Todo hecho a mano, nada de plantillas.
    </h2>
    <div class="portada-rail" data-reveal>
      <p class="bajada">
        Creative developer. Cada trabajo sale de esta imprenta con identidad propia — este
        sitio también: <strong>cambiá la edición arriba y mirá cómo se reimprime</strong>.
      </p>
      <a class="cta" href="#tirada">Ver la tirada ↓</a>
    </div>
  </div>
</section>

<style>
  .portada {
    padding-top: clamp(34px, 7vh, 90px);
  }

  /* ---- Masthead ---- */
  .folio {
    margin: 0 0 10px;
    font-size: 11px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--soft);
    overflow-wrap: anywhere;
  }
  .hero-title {
    margin: 0;
    font-family: var(--font-d);
    font-weight: var(--weight-d);
    color: var(--ink);
    font-size: clamp(2.1rem, 0.4rem + 9.2vw, 8rem);
    line-height: 0.98;
    white-space: nowrap;
  }
  .registro {
    position: relative;
    display: inline-block;
    /* variables animadas por registro.ts */
    --r1x: 0em;
    --r1y: 0em;
    --r2x: 0em;
    --r2y: 0em;
    --rega: 0;
  }
  .registro::before,
  .registro::after {
    content: attr(data-text);
    position: absolute;
    inset: 0;
    z-index: -1;
    opacity: var(--rega);
    pointer-events: none;
  }
  .registro::before {
    color: var(--reg-c1);
    transform: translate(var(--r1x), var(--r1y));
  }
  .registro::after {
    color: var(--reg-c2);
    transform: translate(var(--r2x), var(--r2y));
  }
  .masthead-rule {
    margin-top: 14px;
  }

  /* ---- Cuerpo de portada: asimétrico ---- */
  .portada-grid {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    gap: clamp(18px, 3vw, 40px);
    padding: clamp(26px, 5vh, 56px) 0 clamp(40px, 8vh, 90px);
    align-items: start;
  }
  .titular {
    grid-column: 1 / 8;
    margin: 0;
    font-family: var(--font-d);
    font-weight: var(--weight-d);
    font-size: clamp(1.45rem, 0.8rem + 2.6vw, 3.1rem);
    line-height: 1.08;
    text-wrap: balance;
  }
  .portada-rail {
    grid-column: 9 / 13;
    display: flex;
    flex-direction: column;
    gap: 22px;
    border-left: 1px solid var(--line);
    padding-left: clamp(14px, 1.6vw, 24px);
  }
  .bajada {
    margin: 0;
    color: var(--soft);
    font-size: 0.98rem;
    line-height: 1.6;
    max-width: 34ch;
  }
  .bajada strong {
    color: var(--ink);
    font-weight: 600;
  }
  .cta {
    align-self: flex-start;
    font-family: var(--font-m);
    font-size: 13px;
    letter-spacing: 0.06em;
    text-decoration: none;
    color: var(--ink);
    border-bottom: 3px solid var(--accent);
    padding-bottom: 3px;
    transition: color 0.15s;
  }
  .cta:hover {
    color: var(--accent);
    /* misregistration de hover: los canales se corren un pelo */
    text-shadow:
      -2px 0 var(--reg-c1),
      2px 0 var(--reg-c2);
  }

  @media (max-width: 860px) {
    .titular {
      grid-column: 1 / 13;
    }
    .portada-rail {
      grid-column: 1 / 13;
      border-left: none;
      padding-left: 0;
      border-top: 1px solid var(--line);
      padding-top: 18px;
    }
  }
</style>
