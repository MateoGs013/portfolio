---
// Hero de la home. Las clases .hero-title y .only-* tienen reglas
// globales por edición en ediciones.css; el reveal lo maneja site.ts.
---

<section class="hero" aria-label="Presentación">
  <p class="kicker" data-hero="kicker">
    <span class="kicker-line" aria-hidden="true"></span>
    Portfolio 2026 · Buenos Aires · Río de la Plata
  </p>

  <h1 class="hero-title">
    <span class="line"><span class="line-inner" data-hero="line">Mateo</span></span>
    <span class="line alt"><span class="line-inner" data-hero="line">Sonzogni</span></span>
  </h1>

  <div class="cota only-plano" data-hero="deco" aria-hidden="true">
    <div class="cota-line">campo tipográfico · esc 1:1</div>
  </div>
  <p class="prompt-line only-terminal" data-hero="deco" aria-hidden="true">
    $ whoami <span class="ok">→ creative developer · front-end con carácter</span>
  </p>

  <p class="bajada" data-hero="bajada">
    Creative developer. Un mismo portfolio, muchas tintas: <strong>esta página se reimprime en la edición que elijas</strong> — porque diseñar distinto para cada proyecto es exactamente lo que hago.
  </p>

  <div class="hero-meta" data-hero="meta">
    <div><span class="k">Rol</span>Creative developer</div>
    <div><span class="k">Enfoque</span>Front-end · Motion · WebGL</div>
    <div><span class="k">Estado</span>Disponible · 2026</div>
  </div>

  <p class="scroll-hint" data-hero="hint" aria-hidden="true">scrolleá ↓</p>
</section>

<style>
  .hero {
    padding: clamp(60px, 12vh, 130px) 0 clamp(40px, 7vh, 80px);
    position: relative;
  }
  .kicker {
    font-family: var(--font-m);
    font-size: 11px;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--soft);
    margin: 0 0 18px;
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .kicker-line {
    width: 34px;
    height: 1px;
    background: var(--accent);
    transform-origin: left center;
  }
  .hero-title {
    margin: 0;
    font-family: var(--font-d);
    font-weight: var(--weight-d);
    color: var(--ink);
    font-size: clamp(2.6rem, 1rem + 9.5vw, 8.6rem);
    line-height: 0.94;
    text-wrap: balance;
  }
  .line {
    display: block;
    overflow: hidden;
    padding-bottom: 0.06em;
    margin-bottom: -0.06em;
  }
  .line-inner {
    display: inline-block;
    will-change: transform;
  }
  .line.alt .line-inner {
    color: var(--accent);
  }
  .bajada {
    max-width: 34em;
    color: var(--soft);
    margin: 26px 0 0;
    font-size: clamp(0.95rem, 0.85rem + 0.4vw, 1.15rem);
  }
  .bajada strong {
    color: var(--ink);
    font-weight: 600;
  }
  .hero-meta {
    display: flex;
    gap: clamp(18px, 4vw, 48px);
    flex-wrap: wrap;
    margin-top: 40px;
    padding-top: 18px;
    border-top: 1px solid var(--line);
  }
  .hero-meta div {
    font-family: var(--font-m);
    font-size: 12px;
  }
  .hero-meta .k {
    display: block;
    font-size: 10px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--soft);
    margin-bottom: 4px;
  }
  .scroll-hint {
    position: absolute;
    right: 0;
    bottom: 6px;
    margin: 0;
    font-family: var(--font-m);
    font-size: 11px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--soft);
  }
  .prompt-line {
    font-family: var(--font-m);
    font-size: 12px;
    color: var(--soft);
    margin: 14px 0 0;
    overflow-wrap: anywhere;
  }
  .prompt-line .ok {
    color: var(--accent);
  }
  .cota {
    margin-top: 10px;
  }
  .cota-line {
    display: flex;
    align-items: center;
    gap: 8px;
    font-family: var(--font-m);
    font-size: 10px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--accent);
  }
  .cota-line::before,
  .cota-line::after {
    content: '';
    flex: 1;
    height: 1px;
    background: var(--accent);
    opacity: 0.7;
  }
</style>
