---
// Overlay de intro cinemática: la prensa "entinta" y revela el hero.
// site.ts orquesta la timeline y lo remueve del DOM al terminar.
---

<div id="intro" aria-hidden="true">
  <div class="intro-inner">
    <p class="intro-label">Imprenta M·S — entintando</p>
    <p class="intro-counter"><span id="intro-num">000</span><span class="intro-pct">%</span></p>
    <div class="intro-bars">
      <span class="intro-bar"></span>
      <span class="intro-bar"></span>
      <span class="intro-bar"></span>
    </div>
  </div>
</div>

<style>
  #intro {
    position: fixed;
    inset: 0;
    z-index: 100;
    background: var(--ink);
    color: var(--bg);
    display: flex;
    align-items: center;
    justify-content: center;
    will-change: transform;
  }
  .intro-inner {
    display: flex;
    flex-direction: column;
    gap: 18px;
    align-items: flex-start;
    padding: 0 clamp(16px, 4vw, 48px);
    width: min(560px, 100%);
  }
  .intro-label {
    margin: 0;
    font-family: var(--font-m);
    font-size: 11px;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    opacity: 0.7;
  }
  .intro-counter {
    margin: 0;
    font-family: var(--font-m);
    font-weight: 700;
    font-size: clamp(3rem, 2rem + 6vw, 6rem);
    line-height: 1;
    font-variant-numeric: tabular-nums;
  }
  .intro-pct {
    font-size: 0.4em;
    opacity: 0.6;
    margin-left: 0.1em;
  }
  .intro-bars {
    display: flex;
    gap: 8px;
    width: 100%;
  }
  .intro-bar {
    height: 4px;
    background: var(--accent);
    width: 0%;
    flex: none;
  }
</style>
