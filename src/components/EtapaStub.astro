---
// Stub honesto de una etapa todavía no construida: jamás un 404 desde la
// cabecera (docs/etapas/ideacion.md). Misma cabecera que la home; una frase
// sobre QUÉ va a pasar acá y la vuelta a lo que ya se puede ver.
interface Props {
  etapa: 'maquetado' | 'programacion' | 'producto';
  titulo: string;
}
const { etapa, titulo } = Astro.props;
const etiquetas = {
  maquetado: 'maquetado',
  programacion: 'programación',
  producto: 'producto',
} as const;
---

<div class="stub">
  <header class="cabecera">
    <p class="firma">mateo sonzogni</p>
    <nav class="etapas" aria-label="Etapas del trabajo">
      <a href="/">ideación</a>
      <a href="/maquetado" aria-current={etapa === 'maquetado' ? 'page' : undefined}>maquetado</a>
      <a href="/programacion" aria-current={etapa === 'programacion' ? 'page' : undefined}
        >programación</a
      >
      <a href="/producto" aria-current={etapa === 'producto' ? 'page' : undefined}>producto</a>
    </nav>
    <button class="tinta" id="mode-btn" aria-label="Cambiar la tinta entre modo claro y oscuro">
      ◐
    </button>
  </header>

  <main class="cuerpo wrap">
    <h1 class="titulo">{titulo}</h1>
    <p class="aviso">
      La etapa {etiquetas[etapa]} está en el banco de trabajo. Lo que ya se puede ver arranca en{' '}
      <a href="/">ideación</a>.
    </p>
    <slot />
  </main>
</div>

<style>
  .cabecera {
    display: flex;
    align-items: baseline;
    gap: clamp(14px, 3vw, 34px);
    flex-wrap: wrap;
    padding: 16px clamp(16px, 4vw, 48px);
  }
  .firma {
    margin: 0;
    font-family: var(--font-b);
    font-weight: 600;
    font-size: 14px;
  }
  .etapas {
    margin-left: auto;
    display: flex;
    gap: clamp(10px, 1.8vw, 22px);
    flex-wrap: wrap;
  }
  .etapas a {
    font-family: var(--font-m);
    font-size: 13px;
    text-decoration: none;
    color: var(--soft);
  }
  .etapas a:hover {
    color: var(--ink);
  }
  .etapas a[aria-current='page'] {
    color: var(--ink);
    font-weight: 700;
  }
  .tinta {
    border: 0;
    background: none;
    padding: 0 2px;
    cursor: pointer;
    font-size: 15px;
    line-height: 1;
    color: var(--soft);
  }
  .tinta:hover {
    color: var(--ink);
  }

  .cuerpo {
    min-height: 70svh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding-top: 8svh;
    padding-bottom: 8svh;
  }
  .titulo {
    margin: 0 0 18px;
    font-family: var(--font-d);
    font-weight: 900;
    font-stretch: 62%;
    font-size: clamp(2.2rem, 6.4vw, 5.8rem);
    line-height: 1;
    max-width: 16ch;
  }
  .aviso {
    margin: 0 0 26px;
    color: var(--soft);
    max-width: 52ch;
  }
  .aviso a {
    color: var(--ink);
    text-decoration: none;
    border-bottom: 1px solid var(--line);
  }
  .aviso a:hover {
    border-color: var(--ink);
  }
</style>

<script>
  import '../scripts/site';
</script>
