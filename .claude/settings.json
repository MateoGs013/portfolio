{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "[ -f package.json ] && pnpm typecheck 2>&1 | tail -20 || true"
          }
        ]
      }
    ]
  }
}
