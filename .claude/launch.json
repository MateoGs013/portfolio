{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "rediseno-demo",
      "runtimeExecutable": "node",
      "runtimeArgs": ["docs/rediseno/serve.mjs"],
      "port": 4321
    },
    {
      "name": "api",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["dev:api"],
      "port": 3001
    },
    {
      "name": "eros-mock",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["exec", "tsx", "tests/admin/eros-mock.ts"],
      "env": { "PORT": "3998" },
      "port": 3998
    },
    {
      "name": "admin",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["dev:api"],
      "env": { "HUNTER_API_URL": "http://127.0.0.1:3998" },
      "port": 3001
    },
    {
      "name": "sitio",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["dev"],
      "port": 3000
    }
  ]
}
