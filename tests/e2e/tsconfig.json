{
  // La suite e2e, las pruebas de la API del admin (tests/admin) y sus configuraciones: fuera de los
  // tsconfig de Nuxt, se revisan con `pnpm typecheck`.
  "compilerOptions": {
    "target": "es2023",
    "lib": ["es2023", "dom", "dom.iterable"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "types": ["node"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": ["./**/*.ts", "../admin/**/*.ts", "../../playwright.config.ts", "../../playwright.admin.config.ts"]
}
