{
  // El admin nuevo (Vite + Vue). vue-tsc lo revisa en `pnpm typecheck`.
  // @shared apunta a server/src/shared: del contrato del servidor solo se importan tipos.
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["vite/client", "node"],
    "jsx": "preserve",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "noEmit": true,
    "paths": {
      "@shared/*": ["../src/shared/*"]
    }
  },
  // Componentes y directivas desconocidos son error; los atributos que pasan de largo (data-*, form)
  // son parte de Vue y se permiten.
  "vueCompilerOptions": {
    "checkUnknownComponents": true,
    "checkUnknownDirectives": true,
    "checkUnknownEvents": true
  },
  "include": ["src/**/*.ts", "src/**/*.vue", "vite.config.ts"]
}
